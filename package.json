{
  "name": "MMM-LeagueStats",
  "version": "2.0.1",
  "description": "",
  "main": "MMM-LeagueStats.js",
  "devDependencies": {
    "prettier": "^2.8.4",
    "sass": "^1.100.0"
  },
  "scripts": {
    "generate:assets": "sass --no-source-map --style=compressed --load-path=. sass/_all.sass MMM-LeagueStats.css",
    "watch:assets": "sass --watch --no-source-map --style=compressed --load-path=. sass/_all.sass:MMM-LeagueStats.css",
    "lint": "npm run generate:assets && prettier --check .",
    "lint:fix": "npm run generate:assets && prettier --write .",
    "test": "npm run generate:assets && npm run lint"
  },
  "sandbox": {
    "startup": ["watch:assets"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "deep-diff": "^1.0.2",
    "mqtt": "^4.3.7",
    "zepto": "^1.2.0"
  }
}
